{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "regex": "^/(19|20)\\d{2}/.*", "destination": "/410.html", "type": 410 },
      { "regex": "^/(search|feeds|label|archive|p|b)(/.*)?$", "destination": "/410.html", "type": 410 }
    ],
    "headers": [
      {
        "glob": "410.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  }
}
